# Copia este archivo como .env.local y completa los valores de TU proyecto.
# .env.local está en .gitignore: nunca subas claves al repositorio.
#
# Dónde encontrarlos: Supabase → tu proyecto → Project Settings → API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon public"  (es pública por diseño; la que NO
#                            se publica jamás es la service_role)
#
# Si estos valores faltan, la aplicación arranca en modo demostración:
# guarda el avance solo en el navegador y lo advierte en pantalla.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
